// Floristry ERP — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id            String     @id @default(cuid())
  name          String     @unique
  contactPerson String?
  phone         String?
  email         String?
  leadTimeDays  Float?
  paymentTerms  String?
  notes         String?
  materials     Material[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Material {
  id                 String     @id @default(cuid())
  sku                String     @unique
  name               String
  category           String     // flower | foliage | packaging | other
  unit               String     // pack | stem | wrap | piece | meter
  unitCost           Float?
  supplier          String?
  supplierId         String?
  supplierRef        Supplier?  @relation(fields: [supplierId], references: [id])
  currentStockPacks  Float?
  reorderLevelPacks  Float?
  reorderQtyPacks    Float?
  packPrice          Float?
  unitsPerPack       Float?     // null = unknown / not set
  colors             String?
  notes              String?
  recipeLines        RecipeLine[]
  stockAdjustments   StockAdjustment[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Product {
  id                      String       @id @default(cuid())
  sku                     String      @unique
  name                    String
  category                String      // Bouquet | Arrangement | ...
  size                    String?     // Large | Medium | Small
  flowersCost             Float       @default(0)
  otherMaterialsCost      Float       @default(0)
  totalCost               Float       @default(0)
  suggestedPriceBeforeIva Float       @default(0)
  suggestedPriceWithIva   Float       @default(0)
  actualPriceBeforeIva     Float       @default(0)
  actualPriceWithIva      Float       @default(0)
  marginPct               Float       @default(0)
  linesToReview           Int         @default(0)
  description             String?
  recipeLines             RecipeLine[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model RecipeLine {
  id            String   @id @default(cuid())
  productSku    String
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  componentSku  String
  materialId    String
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  componentName String
  qty           Float
  unit          String
  unitCost      Float    @default(0)
  lineCost      Float    @default(0)
  category      String   @default("other")
  color         String?
  check         String?
  notes         String?
  createdAt     DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  events    Event[]

  @@unique([name, phone])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique // e.g. ORD-1001
  status          String   @default("draft")
  // draft | quote_sent | awaiting_payment | payment_confirmed | procuring | producing | delivered | fulfilled | cancelled

  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  eventId         String?
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  deliveryDate    DateTime?
  deliveryAddress String?

  // Notes
  cardMessage     String?
  deliveryNotes   String?
  internalNotes   String?

  // Money
  deliveryFee     Float    @default(100) // flat rate per address
  discount        Float    @default(0)
  // subtotal, iva, total are computed (not stored)

  // Sales pipeline tracking
  quoteSentAt       DateTime?
  quoteSentVia      String? // whatsapp | email | sms | in_person
  paymentMethod     String? // cash | spei | online_link | card
  paymentOptionsSentAt DateTime?
  paymentInstructionsSent Boolean @default(false)
  paymentStatus     String   @default("not_started")
  // not_started | pending | confirmed | refunded | failed
  paymentConfirmedAt DateTime?
  paymentAmount     Float?
  paymentReference  String? // SPEI ref, Stripe charge ID, etc.

  // Procurement
  procurementStartedAt DateTime?
  producedAt           DateTime?
  deliveredAt          DateTime?
  fulfilledAt          DateTime?
  cancelledAt          DateTime?

  lineItems       OrderLineItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderLineItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productSku  String
  productName String
  productSize String?
  qty         Int
  unitPrice   Float // snapshot — locked at order time
  createdAt   DateTime @default(now())
}

/**
 * Materials from external supplier catalogues (e.g. "El Gato" per-stem price list).
 * Each item links to its best-matching ERP SKU via erpSku (may be empty if no match).
 *
 * Used by the Custom tab to build custom bouquets on the fly.
 */
model CustomMaterial {
  id           String   @id @default(cuid())
  name         String
  pricePerStem Float
  type         String   // flower | foliage
  class        String?  // wild | garden | exotic | romantic
  source       String   @default("El Gato") // which catalogue this came from
  erpSku       String?  // best-matching ERP SKU (may be null)
  erpName      String?  // for display, denormalized
  matchScore   Float?   // 0=perfect, 1=worst
  matchConfidence String? // HIGH | MEDIUM | LOW | VERY_LOW | NO_MATCH
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customRecipeLines CustomRecipeLine[]
}

/**
 * A custom bouquet built by the user in the Custom tab.
 * When saved, also creates a Product + RecipeLine in the ERP tables
 * so it appears in the Catalogue tab.
 */
model CustomRecipe {
  id              String   @id @default(cuid())
  name            String
  size            String?  // Large | Medium | Small
  description     String?
  // Computed at save time using ERP pricing rules:
  flowersCost     Float    @default(0)
  otherMaterialsCost Float @default(0)
  totalCost       Float    @default(0)
  suggestedPrice  Float    @default(0)
  actualPrice     Float    @default(0) // user-set
  // Linked ERP product (created on save — only when hidden=false)
  erpProductSku   String?  @unique
  // When true: recipe is saved for reference but NOT created as ERP Product
  // (used by "Create Order" flow — order line item carries the breakdown instead)
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           CustomRecipeLine[]
}

model CustomRecipeLine {
  id               String   @id @default(cuid())
  customRecipeId   String
  customRecipe     CustomRecipe @relation(fields: [customRecipeId], references: [id], onDelete: Cascade)
  customMaterialId String
  customMaterial   CustomMaterial @relation(fields: [customMaterialId], references: [id], onDelete: Cascade)
  qty              Int
  // Snapshot of the material at the time of recipe creation
  materialName     String
  materialPrice    Float
  materialType     String // flower | foliage
  createdAt        DateTime @default(now())
}

/**
 * UI-initiated stock movements (losses, expirations, adjustments, receipts).
 * These are separate from the Excel's Stock Movements tab — they track
 * changes made through the app's Inventory tab.
 */
model StockAdjustment {
  id          String   @id @default(cuid())
  materialSku String
  material    Material @relation(fields: [materialSku], references: [sku], onDelete: Cascade)
  deltaPacks  Float    // signed: +N for receipts/adjustments up, -N for losses/expiration
  reason      String   // "loss" | "expiration" | "adjustment" | "receipt" | "sample" | "other"
  notes       String?
  createdAt   DateTime @default(now())
}

/**
 * Purchase Orders generated from the Shopping List.
 * One PO per supplier per shopping list generation.
 */
model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique // e.g. PO-3001
  supplier        String
  status          String   @default("draft") // draft | approved | pending | procured | received | cancelled
  totalCost       Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  poId            String
  po              PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialSku     String
  materialName    String
  qtyPacks        Int
  costPerPack     Float
  lineTotal       Float
  createdAt       DateTime @default(now())
}

/**
 * Events bundle multiple orders under one occasion (wedding, corporate, etc.)
 */
model Event {
  id          String   @id @default(cuid())
  eventNumber String   @unique // EVT-2001
  name        String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventDate   DateTime?
  guests      Int?
  status      String   @default("quote") // quote | confirmed | in_progress | completed | cancelled
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}
