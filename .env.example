# Flor by Maria ERP — env var documentation
#
# Copy this file to .env (local) or set these in Vercel (production).

# Database
# --------
# Local dev: file:./db/custom.db  (uses @prisma/adapter-better-sqlite3)
# Production: libsql://<your-db>.turso.io?authToken=<token>
#             (uses @prisma/adapter-libsql)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Demo auth (v1.8)
# ----------------
# Shared demo password. Set in Vercel for production.
# Example: flor2026demo
DEMO_PASSWORD=

# HMAC-SHA256 secret for signing the demo auth cookie.
# Generate with: openssl rand -hex 32
# MUST be set in production. Without it, all routes return 500.
AUTH_SECRET=

# (Optional) Turso database URL — currently unused (DATABASE_URL is the
# canonical source of truth). Kept for backwards compatibility.
TURSO_DATABASE_URL=
